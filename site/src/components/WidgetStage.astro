---
// The hero stage: a piece of desktop with a Pocket widget built from HTML and
// CSS, so it stays sharp and can be dragged. src/scripts/widget-demo.ts runs
// the demo loop and handles dragging, docking and the panel.
//
// Animations (only transform and opacity, with one exception):
// - A3 drag and dock: translate3d on .widget, driven by the script.
// - A4 panel open/close: opacity + scale on .panel; closing is a plain fade.
// - A5 panel resize: width/height on .panel. This is the one layout
//   animation: the panel is absolutely positioned with `contain: layout
//   paint`, so nothing outside it reflows.
// - A6 orientation flip: masked on .strip by the script (Web Animations).
---

<svg class="sprite" width="0" height="0" aria-hidden="true">
  <symbol id="i-bolt" viewBox="0 0 16 16"><path fill="currentColor" d="M9.3 1.2 3.4 9h3.9l-.6 5.8L12.6 7H8.7l.6-5.8Z"></path></symbol>
  <symbol id="i-cal" viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M2.5 6.6h11" stroke="currentColor" stroke-width="1.4"></path><path d="M5 9.2h1.4M7.3 9.2h1.4M9.6 9.2H11M5 11.4h1.4M7.3 11.4h1.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path></symbol>
  <symbol id="i-mail" viewBox="0 0 16 16"><rect x="1.6" y="3.4" width="12.8" height="9.2" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="m2.4 4.6 5.6 4.3 5.6-4.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></symbol>
  <symbol id="i-note" viewBox="0 0 16 16"><rect x="2.4" y="2.8" width="11.2" height="10.4" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M2.6 5.8h10.8M5 8.6h6M5 10.8h3.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></symbol>
  <symbol id="i-spark" viewBox="0 0 16 16"><path fill="currentColor" d="M7 3.2 8.2 7l3.8 1.2L8.2 9.4 7 13.2 5.8 9.4 2 8.2 5.8 7 7 3.2ZM12.4 1.6l.5 1.7 1.7.5-1.7.5-.5 1.7-.5-1.7-1.7-.5 1.7-.5.5-1.7Z"></path></symbol>
  <symbol id="i-x" viewBox="0 0 12 12"><path d="m2 2 8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></symbol>
</svg>

<div
  class="stage"
  id="stage"
  role="group"
  aria-label="Live demo: the Pocket widget on a desktop. Drag it to move it."
>
  <div class="menubar" aria-hidden="true">
    <i style="width:10px"></i><i style="width:34px"></i><i style="width:22px"></i><i
      style="width:26px"></i><span class="clock">Tue 10 Nov 09:12</span>
  </div>
  <div class="ghost ghost-a" aria-hidden="true">
    <i style="width:62%"></i><i style="width:88%"></i><i style="width:80%"></i><i
      style="width:46%"></i><i style="width:84%"></i><i style="width:70%"></i>
  </div>
  <div class="ghost ghost-b" aria-hidden="true">
    <i style="width:40%"></i><i style="width:90%"></i><i style="width:76%"></i><i
      style="width:82%"></i><i style="width:55%"></i>
  </div>

  <div class="widget" id="widget" data-o="v">
    <div class="panel" id="panel" data-side="l" aria-hidden="true">
      <div class="p-head"><b>Calendar</b><span>Tue, 10 Nov</span><svg><use href="#i-x"></use></svg></div>
      <div class="p-sec"><span>TODAY</span><span>4</span></div>
      <div class="p-group">
        <div class="row"><time>09:30</time><span class="bar"></span><div><b>Marketing standup</b><small>15m</small></div></div>
        <div class="row"><time>13:00</time><span class="bar"></span><div><b>Campaign review: Fall Launch</b><small>1h00 · Room 2A</small></div></div>
        <div class="row"><time>15:30</time><span class="bar"></span><div><b>1:1 with Jess</b><small>30m</small></div></div>
        <div class="row"><time>19:00</time><span class="bar g"></span><div><b>Yoga</b><small>1h00 · Flow Studio, Alameda</small></div></div>
      </div>
      <div class="p-sec"><span>TOMORROW</span><span>3</span></div>
      <div class="p-group">
        <div class="row"><time>11:00</time><span class="bar"></span><div><b>Board deck working session</b><small>1h00</small></div></div>
        <div class="row"><time>15:00</time><span class="bar"></span><div><b>Call with Marcus (North Peak)</b><small>30m</small></div></div>
        <div class="row"><time>19:30</time><span class="bar g"></span><div><b>Dinner with Nina</b><small>2h00 · Osteria Nove</small></div></div>
      </div>
      <span class="rgrip w"></span><span class="rgrip h"></span>
    </div>
    <div
      class="strip"
      id="strip"
      role="button"
      tabindex="0"
      aria-expanded="false"
      aria-label="Pocket widget. Drag to move, press to open or close."
    >
      <span class="grip" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="cell"><svg aria-hidden="true"><use href="#i-bolt"></use></svg></span>
      <span class="cell" id="cell-cal"><svg aria-hidden="true"><use href="#i-cal"></use></svg></span>
      <span class="cell badge"><svg aria-hidden="true"><use href="#i-mail"></use></svg></span>
      <span class="cell"><svg aria-hidden="true"><use href="#i-note"></use></svg></span>
      <span class="cell"><svg aria-hidden="true"><use href="#i-spark"></use></svg></span>
    </div>
  </div>

  <svg class="cursor" id="cursor" viewBox="0 0 18 22" aria-hidden="true"><path d="M2 1.5v16l4.3-3.9 2.7 6.3 2.6-1.1-2.7-6.2H15L2 1.5Z" fill="#fff" stroke="#0B0B0A" stroke-width="1.2" stroke-linejoin="round"></path></svg>
  <span class="hint mono"><span class="dot"></span><span id="hint-text">Live · drag the widget</span></span>
</div>

<script>
  import { initWidgetDemo } from '../scripts/widget-demo';

  initWidgetDemo();
</script>

<style>
  .sprite {
    position: absolute;
  }

  /* The stage: a piece of desktop. */
  .stage {
    position: relative;
    aspect-ratio: 5 / 4;
    max-width: 100%;
    border-radius: var(--r-stage);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--hairline);
    background:
      radial-gradient(42% 46% at 78% 30%, var(--wall-glow), transparent 70%),
      radial-gradient(46% 50% at 18% 82%, var(--wall-glow-2), transparent 70%),
      linear-gradient(155deg, var(--wall-a), var(--wall-b));
    user-select: none;
    -webkit-user-select: none;
  }

  .menubar {
    position: absolute;
    inset: 0 0 auto;
    height: 24px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 12px;
    background: var(--ghost);
    border-bottom: 1px solid var(--ghost-line);
  }

  .menubar i {
    height: 5px;
    border-radius: 3px;
    background: var(--ink-3);
    opacity: 0.55;
  }

  .clock {
    margin-left: auto;
    font: 500 10.5px/1 var(--mono);
    color: var(--ink-2);
  }

  .ghost {
    position: absolute;
    border-radius: 12px;
    background: var(--ghost);
    border: 1px solid var(--ghost-line);
    padding: 34px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .ghost::before {
    content: '';
    position: absolute;
    left: 12px;
    top: 12px;
    width: 34px;
    height: 8px;
    border-radius: 4px;
    background: var(--ghost-line);
  }

  .ghost i {
    height: 7px;
    border-radius: 4px;
    background: var(--ghost-line);
  }

  .ghost-a {
    left: 9%;
    top: 15%;
    width: 52%;
    height: 60%;
  }

  .ghost-b {
    left: 34%;
    top: 36%;
    width: 44%;
    height: 52%;
  }

  .hint {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: var(--r-control);
    background: var(--glass);
    color: var(--w-2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-stroke);
    pointer-events: none;
  }

  /* ---------- the widget ---------- */

  /* Before the script positions it, the widget rests at the right edge. */
  .widget {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform;
    z-index: 2;
  }

  .strip {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 6px 4px;
    width: 44px;
    border-radius: var(--r-strip);
    background: var(--glass);
    border: 1px solid var(--glass-stroke);
    backdrop-filter: blur(24px) saturate(1.5);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    box-shadow: var(--shadow);
    cursor: grab;
    touch-action: none;
    transition: transform 160ms var(--ease-out);
  }

  /* The strip is dark glass on any wallpaper: keep its focus ring light. */
  .strip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--r-strip);
  }

  .widget[data-o='h'] .strip {
    flex-direction: row;
    width: auto;
    height: 44px;
    padding: 4px 6px;
  }

  .widget:global(.held) .strip {
    transform: scale(1.04);
    cursor: grabbing;
  }

  .grip {
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    flex: none;
  }

  .grip i {
    width: 2.5px;
    height: 2.5px;
    border-radius: 50%;
    background: var(--w-3);
  }

  .cell {
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: var(--r-cell);
    display: grid;
    place-items: center;
    color: var(--w-2);
    position: relative;
  }

  .cell svg {
    width: 16px;
    height: 16px;
  }

  .cell:global(.active) {
    background: var(--accent-wash);
    color: var(--accent);
  }

  .cell.badge::after {
    content: '';
    position: absolute;
    top: 6px;
    right: 6px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--critical);
  }

  .panel {
    position: absolute;
    contain: layout paint;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border-radius: var(--r-window);
    background: var(--glass-dense);
    border: 1px solid var(--glass-stroke);
    color: var(--w-1);
    backdrop-filter: blur(28px) saturate(1.5);
    -webkit-backdrop-filter: blur(28px) saturate(1.5);
    box-shadow: var(--shadow);
    opacity: 0;
    transform: scale(0.94);
    pointer-events: none;
    /* Closing: a plain fade, the scale resets after it. */
    transition:
      opacity 150ms ease-out,
      transform 0s linear 150ms,
      width var(--rs-d, 0ms) var(--rs-e, linear),
      height var(--rs-d, 0ms) var(--rs-e, linear);
  }

  .panel:global(.open) {
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms ease-out,
      transform var(--spring-state-d) var(--spring-state),
      width var(--rs-d, 0ms) var(--rs-e, linear),
      height var(--rs-d, 0ms) var(--rs-e, linear);
  }

  .panel[data-side='r'] {
    transform-origin: 0 30%;
  }

  .panel[data-side='l'] {
    transform-origin: 100% 30%;
  }

  .panel[data-side='b'] {
    transform-origin: 50% 0;
  }

  .panel[data-side='t'] {
    transform-origin: 50% 100%;
  }

  .p-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex: none;
  }

  .p-head b {
    font-size: 15px;
    font-weight: 600;
  }

  .p-head span {
    font-size: 12px;
    color: var(--w-3);
    white-space: nowrap;
  }

  .p-head svg {
    margin-left: auto;
    width: 12px;
    height: 12px;
    color: var(--w-3);
    align-self: center;
    flex: none;
  }

  .p-sec {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    color: var(--w-3);
    padding: 0 4px;
    flex: none;
  }

  .p-group {
    border-radius: var(--r-group);
    background: var(--w-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    flex: none;
  }

  .row {
    display: grid;
    grid-template-columns: 40px 3px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 9px 12px;
  }

  .row + .row {
    border-top: 1px solid var(--w-hair);
  }

  .row time {
    font-size: 12px;
    color: var(--w-2);
    font-variant-numeric: tabular-nums;
  }

  .bar {
    width: 3px;
    height: 26px;
    border-radius: 2px;
    background: var(--event-blue);
  }

  .bar.g {
    background: var(--event-green);
  }

  .row b {
    display: block;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row small {
    display: block;
    font-size: 12px;
    color: var(--w-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rgrip {
    position: absolute;
    border-radius: 1.5px;
    background: rgba(255, 255, 255, 0.22);
  }

  .rgrip.w {
    width: 3px;
    height: 34px;
    top: calc(50% - 17px);
  }

  .panel[data-side='r'] .rgrip.w,
  .panel[data-side='b'] .rgrip.w,
  .panel[data-side='t'] .rgrip.w {
    right: 4px;
  }

  .panel[data-side='l'] .rgrip.w {
    left: 4px;
  }

  .rgrip.h {
    height: 3px;
    width: 34px;
    left: calc(50% - 17px);
    bottom: 4px;
  }

  .panel[data-side='t'] .rgrip.h {
    bottom: auto;
    top: 4px;
  }

  .cursor {
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 22px;
    max-width: none;
    z-index: 3;
    opacity: 0;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
  }

  @media (max-width: 760px) {
    .stage {
      aspect-ratio: 4 / 5;
      border-radius: 20px;
    }

    .ghost-a {
      left: 6%;
      width: 70%;
      top: 12%;
      height: 46%;
    }

    .ghost-b {
      left: 20%;
      width: 62%;
      top: 44%;
      height: 44%;
    }
  }

  /* Reduced motion: no loop and no cursor (the script), opacity-only panel. */
  @media (prefers-reduced-motion: reduce) {
    .panel,
    .panel:global(.open) {
      transform: none;
      transition: opacity 150ms ease-out;
    }

    .widget:global(.held) .strip {
      transform: none;
    }
  }
</style>
