---
// "Put it anywhere": three numbered figures. Each is a small drawing of a
// screen with the widget on it, and plays one move when it is first seen and
// again on hover (src/scripts/motion.ts adds `.play`): 1 slides to the edge
// and docks, 2 grows from a handle, 3 is dropped and stays. Without `.play`
// the drawings rest in their final pose.
//
// Below them: a halftone picture of a laptop with the widget on its screen,
// dragged from the left side (the dashed ghost) to the right. Every overlay
// piece is placed in percentages of the 1024×576 frame, so it scales with the
// picture. src/scripts/motion.ts sets `data-wait` (the starting pose) while
// the picture is below the fold, then swaps it for `.play` when it is seen.
// Without script, or with reduced motion, the final state shows.
import { Picture } from 'astro:assets';
import Marker from './Marker.astro';
import laptop from '../assets/pictures/laptop.png';
import calendar from '../assets/screens/calendar.png';
---

<section class="section container">
  <Marker letter="O" />
  <h2 class="h indent">put it anywhere</h2>
  <p class="lede indent section__lede">
    drag it to any edge of the screen, or leave it floating. it stays where you left it.
  </p>

  <ol class="figs">
    <li class="fig" data-fig>
      <span class="fig__n" aria-hidden="true">1</span>
      <div class="fig__col">
        <div class="fig__card">
          <div class="scr" aria-hidden="true">
            <i class="scr__bar"></i>
            <div class="f1">
              <i class="w f1__strip"></i>
              <i class="w f1__panel"></i>
            </div>
          </div>
        </div>
        <p class="body fig__cap">drag it to an edge and it docks there</p>
      </div>
    </li>

    <li class="fig" data-fig>
      <span class="fig__n" aria-hidden="true">2</span>
      <div class="fig__col">
        <div class="fig__card">
          <div class="scr" aria-hidden="true">
            <i class="scr__bar"></i>
            <i class="w f2__strip"></i>
            <div class="f2">
              <i class="w f2__panel"></i>
              <i class="f2__e f2__e--t"></i>
              <i class="f2__e f2__e--r"></i>
              <i class="f2__e f2__e--b"></i>
              <i class="f2__e f2__e--l"></i>
              <i class="f2__h f2__h--tl"></i>
              <i class="f2__h f2__h--tr"></i>
              <i class="f2__h f2__h--br"></i>
              <i class="f2__h f2__h--bl"></i>
            </div>
          </div>
        </div>
        <p class="body fig__cap">pull a side to make it the size you need</p>
      </div>
    </li>

    <li class="fig" data-fig>
      <span class="fig__n" aria-hidden="true">3</span>
      <div class="fig__col">
        <div class="fig__card">
          <div class="scr" aria-hidden="true">
            <i class="scr__bar"></i>
            <i class="f3__ghost"></i>
            <div class="f3">
              <i class="w f3__strip"></i>
              <i class="w f3__panel"></i>
            </div>
          </div>
        </div>
        <p class="body fig__cap">let go anywhere and it stays put</p>
      </div>
    </li>
  </ol>

  <div class="indent">
    <div class="lap" id="lap">
      <Picture
        src={laptop}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[640, 832, 1024, 1376]}
        sizes="(max-width: 699px) calc(100vw - 32px), (max-width: 1151px) calc(100vw - 128px), 1024px"
        alt="Pocket on a laptop screen, moved from one side to the other."
        loading="lazy"
        class="lap__bg"
      />
      <div class="lap__over" aria-hidden="true">
        <i class="lap__ghost"></i>
        <i class="lap__path"></i>
        <div class="lap__move">
          <Picture
            src={calendar}
            formats={['avif', 'webp']}
            widths={[163, 326, 489]}
            sizes="(max-width: 1151px) 16vw, 163px"
            alt=""
            loading="lazy"
            class="lap__img"
          />
          <svg class="lap__cursor" viewBox="0 0 14 20">
            <path d="M1 1 V16.2 L4.9 12.6 L7.6 18.8 L10 17.8 L7.3 11.7 H12.6 Z"></path>
          </svg>
        </div>
        <div class="lap__sel"><i></i><i></i><i></i><i></i></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The number boxes sit in the indent, so the cards line up with the text. */
  .figs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    padding: 0 0 0 calc(var(--indent) - 32px);
    list-style: none;
  }

  .fig {
    display: flex;
    align-items: flex-start;
    min-width: 0;
    max-width: 100%;
  }

  .fig__n {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    background: var(--text);
    color: var(--ground);
    font-size: 16px;
    font-weight: 600;
    line-height: 18px;
  }

  .fig__col {
    display: flex;
    flex-direction: column;
    flex: 0 1 296px;
    gap: var(--s-2);
    min-width: 0;
  }

  .fig__card {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 224px;
    background: var(--card);
  }

  .fig__cap {
    max-width: 280px;
    padding-left: var(--s-1);
  }

  /* The small screen: 216×136 with a menu bar line. */
  .scr {
    position: relative;
    flex: none;
    width: 216px;
    height: 136px;
    background: var(--ground);
    border: 1px solid var(--text);
    overflow: hidden;
  }

  .scr i,
  .scr div {
    position: absolute;
    display: block;
  }

  .scr__bar {
    left: 0;
    top: 0;
    width: 100%;
    height: 9px;
    border-bottom: 1px solid var(--text);
  }

  /* A piece of the widget. */
  .w {
    background: var(--text);
    border-radius: 4px;
  }

  /* 1: the widget, docked to the right edge. */
  .f1 {
    inset: 0;
  }

  .f1__strip {
    right: 4px;
    top: 44px;
    width: 9px;
    height: 52px;
  }

  .f1__panel {
    right: 16px;
    top: 26px;
    width: 52px;
    height: 88px;
  }

  .fig.play .f1 {
    animation: f1-dock 900ms var(--ease-out) 150ms backwards;
  }

  @keyframes f1-dock {
    from {
      transform: translate3d(-104px, 0, 0);
    }
  }

  /* 2: the panel inside a selection outline (88×100), strip on the left. */
  .f2__strip {
    left: 4px;
    top: 23px;
    width: 9px;
    height: 52px;
  }

  .f2 {
    left: 19px;
    top: 23px;
    width: 88px;
    height: 100px;
  }

  .f2__panel {
    left: 2px;
    top: 2px;
    width: 84px;
    height: 96px;
    transform-origin: -2px -2px;
  }

  .f2__e {
    background: var(--select);
  }

  .f2__e--t,
  .f2__e--b {
    left: 0;
    width: 100%;
    height: 1px;
    transform-origin: 0 0;
  }

  .f2__e--l,
  .f2__e--r {
    top: 0;
    width: 1px;
    height: 100%;
    transform-origin: 0 0;
  }

  .f2__e--t {
    top: 0;
  }

  .f2__e--b {
    bottom: 0;
  }

  .f2__e--l {
    left: 0;
  }

  .f2__e--r {
    right: 0;
  }

  .f2__h {
    width: 5px;
    height: 5px;
    background: #fff;
    border: 1px solid var(--select);
  }

  .f2__h--tl,
  .f2__h--tr {
    top: -2px;
  }

  .f2__h--bl,
  .f2__h--br {
    bottom: -2px;
  }

  .f2__h--tl,
  .f2__h--bl {
    left: -2px;
  }

  .f2__h--tr,
  .f2__h--br {
    right: -2px;
  }

  /* The outline starts at 55% and grows from its top left corner, pulled by
     the bottom right handle. Edges stretch and handles travel, so the line
     weight and handle size never change. 88 × 0.45 = 39.6, 100 × 0.45 = 45. */
  .fig.play .f2__panel {
    animation: f2-panel 800ms var(--ease-in-out) 250ms backwards;
  }

  .fig.play .f2__e--t {
    animation: f2-x 800ms var(--ease-in-out) 250ms backwards;
  }

  .fig.play .f2__e--l {
    animation: f2-y 800ms var(--ease-in-out) 250ms backwards;
  }

  .fig.play .f2__e--b {
    animation: f2-bottom 800ms var(--ease-in-out) 250ms backwards;
  }

  .fig.play .f2__e--r {
    animation: f2-right 800ms var(--ease-in-out) 250ms backwards;
  }

  .fig.play .f2__h--tr {
    animation: f2-tr 800ms var(--ease-in-out) 250ms backwards;
  }

  .fig.play .f2__h--bl {
    animation: f2-bl 800ms var(--ease-in-out) 250ms backwards;
  }

  .fig.play .f2__h--br {
    animation: f2-br 800ms var(--ease-in-out) 250ms backwards;
  }

  @keyframes f2-panel {
    from {
      transform: scale(0.55);
    }
  }

  @keyframes f2-x {
    from {
      transform: scaleX(0.55);
    }
  }

  @keyframes f2-y {
    from {
      transform: scaleY(0.55);
    }
  }

  @keyframes f2-bottom {
    from {
      transform: translate3d(0, -45px, 0) scaleX(0.55);
    }
  }

  @keyframes f2-right {
    from {
      transform: translate3d(-39.6px, 0, 0) scaleY(0.55);
    }
  }

  @keyframes f2-tr {
    from {
      transform: translate3d(-39.6px, 0, 0);
    }
  }

  @keyframes f2-bl {
    from {
      transform: translate3d(0, -45px, 0);
    }
  }

  @keyframes f2-br {
    from {
      transform: translate3d(-39.6px, -45px, 0);
    }
  }

  /* 3: the widget floating, away from the dashed place it was docked to. */
  .f3__ghost {
    right: 4px;
    top: 44px;
    width: 9px;
    height: 52px;
    border: 1px dashed var(--tone-3);
    border-radius: 4px;
  }

  .f3 {
    left: 40px;
    top: 14px;
    width: 88px;
    height: 72px;
  }

  .f3__strip {
    left: 0;
    top: 0;
    width: 52px;
    height: 9px;
  }

  .f3__panel {
    left: 0;
    top: 12px;
    width: 88px;
    height: 60px;
  }

  /* Carried in slightly lifted, then let go. */
  .fig.play .f3 {
    animation: f3-drop 1000ms var(--ease-in-out) 150ms backwards;
  }

  @keyframes f3-drop {
    from {
      transform: translate3d(64px, 30px, 0) scale(1.06);
    }

    70% {
      transform: translate3d(0, 0, 0) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fig.play * {
      animation: none !important;
    }
  }

  /* ---------- the laptop picture ---------- */

  /* Same box as the sky picture in the next section. */
  .lap {
    position: relative;
    margin-top: var(--s-7);
    aspect-ratio: 1024 / 576;
    background: var(--ground);
    overflow: hidden;
    overflow: clip;
  }

  .lap :global(.lap__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lap__over {
    position: absolute;
    inset: 0;
  }

  .lap__over > * {
    position: absolute;
    display: block;
  }

  /* Places are fractions of the 1024×576 frame. The lit screen spans about
     x 276–748, y 80–398 in it. */

  /* Where the widget was dragged from: 150×260 at 312, 118. */
  .lap__ghost {
    left: 30.469%;
    top: 20.486%;
    width: 14.648%;
    height: 45.139%;
    border: 1px dashed var(--tone-3);
    border-radius: 10px;
  }

  /* The way it went: a dashed line from 462 to 574 at y 247. */
  .lap__path {
    left: 45.117%;
    top: 42.882%;
    width: 10.938%;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--select) 0 3px, transparent 3px 6px);
    transform-origin: 0 0;
  }

  /* The widget with the cursor on it: 163×260 at 578, 112. */
  .lap__move {
    left: 56.445%;
    top: 19.444%;
    width: 15.918%;
    aspect-ratio: 565 / 900;
  }

  .lap__move :global(.lap__img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The arrow's tip is at 640, 236 of the frame. */
  .lap__cursor {
    position: absolute;
    left: 38.04%;
    top: 47.69%;
    width: 8.6%;
    min-width: 8px;
    max-width: none;
    fill: var(--ground);
    stroke: #fff;
    stroke-width: 1.2;
    stroke-linejoin: round;
    overflow: visible;
  }

  /* Selection outline around the panel: 152×264 at 576, 110. */
  .lap__sel {
    left: 56.25%;
    top: 19.097%;
    width: 14.844%;
    height: 45.833%;
    border: 1px solid var(--select);
  }

  /* Handles: 7px white squares centred on the outline's corners. */
  .lap__sel i {
    position: absolute;
    width: 7px;
    height: 7px;
    background: #fff;
    border: 1px solid var(--select);
  }

  .lap__sel i:nth-child(1),
  .lap__sel i:nth-child(2) {
    top: -4px;
  }

  .lap__sel i:nth-child(3),
  .lap__sel i:nth-child(4) {
    bottom: -4px;
  }

  .lap__sel i:nth-child(1),
  .lap__sel i:nth-child(4) {
    left: -4px;
  }

  .lap__sel i:nth-child(2),
  .lap__sel i:nth-child(3) {
    right: -4px;
  }

  /* Once, when seen: the path draws, the widget and the cursor travel from
     the ghost to the docked place, then the selection appears. The start
     offset is in the widget's own size: 266 of 163 left, 6 of 260 down. */
  @media (prefers-reduced-motion: no-preference) {
    .lap[data-wait] .lap__path {
      transform: scaleX(0);
    }

    .lap[data-wait] .lap__move {
      transform: translate3d(-163.19%, 2.308%, 0);
    }

    .lap[data-wait] .lap__sel {
      opacity: 0;
    }

    .lap.play .lap__path {
      animation: lap-path 350ms var(--ease-out) 200ms backwards;
    }

    .lap.play .lap__move {
      animation: lap-move 900ms var(--ease-in-out) 450ms backwards;
    }

    .lap.play .lap__sel {
      animation: fade-in 120ms ease-out 1400ms backwards;
    }

    .lap.play .lap__sel i {
      animation: lap-pop 160ms var(--ease-out) 1450ms backwards;
    }

    .lap.play .lap__sel i:nth-child(2) {
      animation-delay: 1510ms;
    }

    .lap.play .lap__sel i:nth-child(3) {
      animation-delay: 1570ms;
    }

    .lap.play .lap__sel i:nth-child(4) {
      animation-delay: 1630ms;
    }
  }

  @keyframes lap-path {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes lap-move {
    from {
      transform: translate3d(-163.19%, 2.308%, 0);
    }
  }

  @keyframes lap-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @media (max-width: 699px) {
    .figs {
      flex-direction: column;
    }

    /* Smaller picture: lighter corners and handles. */
    .lap__ghost {
      border-radius: 4px;
    }

    .lap__sel i {
      width: 5px;
      height: 5px;
    }

    .lap__sel i:nth-child(1),
    .lap__sel i:nth-child(2) {
      top: -3px;
    }

    .lap__sel i:nth-child(3),
    .lap__sel i:nth-child(4) {
      bottom: -3px;
    }

    .lap__sel i:nth-child(1),
    .lap__sel i:nth-child(4) {
      left: -3px;
    }

    .lap__sel i:nth-child(2),
    .lap__sel i:nth-child(3) {
      right: -3px;
    }
  }
</style>
