---
// "Pay once, keep it": the Trial and the License as one stack (card, the
// three days, card, the price band) with a tip and the buttons beside it.
// The accent colour appears here only on the price band.
//
// src/scripts/motion.ts sets `data-wait` on `.plan` while it is below the
// fold and removes it when it is seen: the days switch on one by one, then
// the regular price is struck and the launch price takes its place.
import Marker from './Marker.astro';
import { checkoutURL, downloadURL, price } from '../config';
---

<section class="section container">
  <Marker letter="K" />
  <h2 class="h indent">pay once<br />keep it</h2>
  <p class="lede indent section__lede">
    use pocket for 3 days with everything switched on. if it earns its place on your screen,
    buy it once and it’s yours.
  </p>

  <div class="indent price">
    <div class="plan" id="plan">
      <div class="plan__card">
        <h3 class="strong">Trial</h3>
        <p class="body">3 days, every feature, from the first time you open pocket</p>
      </div>
      <div class="days label" aria-hidden="true">
        <span class="day" style="--i:0">day 1</span>
        <span class="day" style="--i:1">day 2</span>
        <span class="day" style="--i:2">day 3</span>
      </div>
      <div class="plan__card">
        <h3 class="strong">License</h3>
        <p class="body">
          one payment, no subscription. one License key works on up to 3 of your Macs
        </p>
      </div>
      <div class="band">
        <p class="band__price">
          <span class="band__now">{price.launch}</span>
          <s class="band__was">{price.regular}</s>
        </p>
        <span class="label band__label">launch price</span>
      </div>
    </div>

    <div class="side">
      <div class="tip">
        <h3 class="tip__title">tip</h3>
        <p class="label">
          use the Trial to decide.<br /><br />a refund is possible within 14 days, as long as the
          License key was never activated.
        </p>
      </div>
      <div class="side__cta">
        <a class="btn btn--light btn--wide" href={checkoutURL}>
          buy pocket <span class="btn__price">{price.launch}</span>
        </a>
        <a class="btn btn--quiet btn--wide" href={downloadURL} download>
          download and start the Trial
        </a>
      </div>
      <p class="label muted">sold by dk2la. payment is handled by Lemon Squeezy.</p>
    </div>
  </div>
</section>

<style>
  .price {
    display: flex;
    align-items: flex-start;
    gap: var(--s-5);
  }

  .plan {
    display: flex;
    flex-direction: column;
    flex: 1 1 608px;
    min-width: 0;
  }

  .plan__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: var(--s-5);
    background: var(--card);
    text-align: center;
  }

  /* The three days of the Trial, lighter to darker. */
  .days {
    display: flex;
    height: var(--s-8);
    background: var(--card);
  }

  .day {
    display: flex;
    align-items: flex-end;
    flex: 1 1 0;
    padding: var(--s-2) var(--s-3);
    background: var(--text);
    color: var(--ground);
    /* Switched, not faded: the change lands all at once after the delay. */
    transition: opacity 0s linear calc(var(--i) * 140ms);
  }

  .day:nth-child(2) {
    background: var(--tone-2);
  }

  .day:nth-child(3) {
    background: var(--tone-3);
  }

  .plan[data-wait] .day {
    opacity: 0;
  }

  .band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: var(--s-8);
    padding-inline: var(--s-5);
    background: var(--accent);
    color: var(--on-accent);
    overflow: hidden;
  }

  .band__price {
    display: flex;
    align-items: baseline;
    flex: none;
    gap: var(--s-3);
    white-space: nowrap;
  }

  .band__now {
    font-size: 60px;
    font-weight: 600;
    line-height: 64px;
    letter-spacing: -0.02em;
    transition:
      opacity 300ms ease-out 1100ms,
      transform 400ms var(--ease-out) 1100ms;
  }

  /* The regular price. The strike is a drawn line, so it can be drawn in. */
  .band__was {
    position: relative;
    font-size: 28px;
    font-weight: 300;
    line-height: 32px;
    letter-spacing: 0;
    text-decoration: none;
    opacity: 0.55;
    transform-origin: 0 78%;
    transition:
      opacity 450ms ease-out 900ms,
      transform 450ms var(--ease-out) 900ms;
  }

  .band__was::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 49%;
    height: 1px;
    background: currentColor;
    transform-origin: 0 0;
    transition: transform 250ms var(--ease-out) 600ms;
  }

  /* Before: the regular price stands, large, where the launch price will be.
     `--shift` is set by the script (the width of the launch price + the gap). */
  .plan[data-wait] .band__now {
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }

  .plan[data-wait] .band__was {
    opacity: 1;
    transform: translate3d(var(--shift, 0px), 0, 0) scale(2.14);
  }

  .plan[data-wait] .band__was::after {
    transform: scaleX(0);
  }

  .band__label {
    text-align: right;
  }

  .side {
    display: flex;
    flex-direction: column;
    flex: 0 0 384px;
    gap: var(--s-5);
    min-width: 0;
  }

  .tip {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
    background: var(--card);
  }

  .tip__title {
    font-size: 20px;
    font-weight: 600;
    line-height: 24px;
  }

  .tip .label {
    line-height: 24px;
  }

  .side__cta {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  /* Long label: let it wrap on the narrowest phones instead of overflowing. */
  .side__cta .btn {
    height: auto;
    min-height: var(--u);
    white-space: normal;
  }

  @media (max-width: 999px) {
    .price {
      flex-direction: column;
      align-items: stretch;
    }

    .plan,
    .side {
      flex: none;
    }
  }

  /* The narrowest phones: a smaller price, so the band still fits one row. */
  @media (max-width: 379px) {
    .band {
      padding-inline: var(--s-3);
    }

    .band__price {
      gap: var(--s-2);
    }

    .band__now {
      font-size: 48px;
    }

    .band__was {
      font-size: 22px;
    }

    .plan__card,
    .tip {
      padding: var(--s-4);
    }
  }
</style>
