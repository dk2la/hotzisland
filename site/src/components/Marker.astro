---
// The section marker: a 64px box with a dot on each corner and a letter
// inside. Down the landing page the letters spell the product name: P, O, C,
// K, E on the sections and T in the footer. Other pages use P. The marker is
// decorative and hidden from screen readers. Styles and the entrance
// animation live in src/styles/global.css (.marker).
//
// `play` runs the entrance on load; use it only for a marker that is on the
// first screen. Markers further down are played by src/scripts/motion.ts.
interface Props {
  letter: 'P' | 'O' | 'C' | 'K' | 'E' | 'T';
  play?: boolean;
}

const { letter, play = false } = Astro.props;
---

<div class:list={['marker', { play }]} aria-hidden="true">
  <i class="marker__dot"></i><i class="marker__dot"></i><i class="marker__dot"></i><i
    class="marker__dot"></i>
  <span class="marker__letter">{letter}</span>
</div>
