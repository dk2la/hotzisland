---
// "Before you buy": four questions as native <details>, so they work without
// script and are keyboard-operable by default.
const questions = [
  {
    q: 'What happens when the Trial ends?',
    a: 'Pocket locks until you enter a License key. There is no limited free version. Starting the Trial needs an internet connection.',
    open: true,
  },
  {
    q: 'Is it a subscription?',
    a: "No. You pay once and the License doesn't expire.",
  },
  {
    q: 'Can I get a refund?',
    a: 'Yes, within 14 days of purchase, as long as the License key was never activated. Once a key is activated the sale is final, so use the Trial to decide.',
  },
  {
    q: 'Which Macs does it run on?',
    a: 'Any Mac with macOS 14 or later. One License key covers up to 3 Macs.',
  },
];
---

<section class="section">
  <div class="container faq">
    <div class="sec-head" data-reveal>
      <h2>Before you buy</h2>
    </div>
    <div class="qa" data-reveal>
      {
        questions.map((item) => (
          <details open={item.open}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-7);
    align-items: start;
  }

  .qa {
    border-top: 1px solid var(--hairline);
  }

  details {
    border-bottom: 1px solid var(--hairline);
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: 18px 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* A10: the chevron turns over when the question opens. */
  summary::after {
    content: '';
    width: 9px;
    height: 9px;
    flex: none;
    border-right: 1.5px solid var(--ink-3);
    border-bottom: 1.5px solid var(--ink-3);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 200ms var(--ease-out);
  }

  details[open] summary::after {
    transform: rotate(225deg) translate(-2px, -2px);
  }

  details p {
    color: var(--ink-2);
    padding: 0 0 20px;
    max-width: 52ch;
  }

  @media (max-width: 760px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    summary::after {
      transition: none;
    }
  }
</style>
