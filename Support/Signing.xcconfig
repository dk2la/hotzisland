// Default: ad-hoc signing, so any clone builds with no certificate.
// Downside of ad-hoc: the signature changes on every build, so Keychain
// re-prompts for the mail password each time. To stop that, create a
// gitignored Support/Signing.local.xcconfig pointing at a stable identity:
//
//   CODE_SIGN_STYLE = Manual
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <your team id>
//
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

// Optional local override — later assignments win.
#include? "Signing.local.xcconfig"
